[Unit]
Description=NodeJS Server for Edu-Extended
After=network.target

[Service]
Type=simple
Restart=always
# RestartSec=5
PIDFile=/run/edu-extended.pid

# You have to change absolute path in next two lines when deploying to another server !!!
# WorkingDirectory=/var/www/vtempe/data/edu-extended
# ExecStart=/root/.nvm/versions/node/v20.19.2/bin/node /var/www/vtempe/data/edu-extended/server.js

# Environment=NODE_PATH=server/

WorkingDirectory=/var/www/vtempe/data/edu-extended
# ExecStart=NODE_PATH=server/ /root/.nvm/versions/node/v20.19.2/bin/node /var/www/vtempe/data/edu-extended/server.js
ExecStart=/root/.nvm/versions/node/v20.19.2/bin/node /var/www/vtempe/data/edu-extended/server.js

[Install]
WantedBy=multi-user.target
